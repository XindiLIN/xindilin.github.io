</span><span class="c1">## Posterior draws</span><span class="w">
</span><span class="n">mcmc_fit</span><span class="o">$</span><span class="n">draws</span><span class="p">(</span><span class="s2">"beta[1,1]"</span><span class="p">)</span><span class="w">

